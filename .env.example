# ============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - SUBMIGUELEÑOS
# ============================================================================

# Puerto del servidor (Railway y Render lo asignan automáticamente)
PORT=3000

# URL de tu Base de Datos PostgreSQL en la nube (Railway Postgres, Render Postgres, Supabase o Neon.tech)
# Si se deja vacío en desarrollo local, usa automáticamente ./data/lealresto-db.json
DATABASE_URL=postgresql://usuario:password@host.neon.tech:5432/submiguelenos?sslmode=require

# Dominio público HTTPS de tu servidor en producción (para compilar la APK apuntando a la nube)
# Ejemplo: https://submiguelenos-production.up.railway.app
PUBLIC_SERVER_URL=
